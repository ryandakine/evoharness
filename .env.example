# Paste the secret after = in your LOCAL .env, never in chat.
LLM_API_KEY=
# Default: let OpenRouter choose an available free model.
LLM_MODEL=openai/openrouter/free
# Optional: custom OpenAI-compatible base URL ending in /v1.
# Leave blank for a native provider's default endpoint.
LLM_API_BASE=https://openrouter.ai/api/v1
